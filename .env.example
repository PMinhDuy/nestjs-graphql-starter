# Application
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_graphql

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# AWS (use IAM execution role on Lambda — no keys needed in production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=nestjs-ecommerce-products

# SQS
ORDER_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/order-queue

# SNS
ORDER_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789:order-events

# Redis (set REDIS_TLS=true for ElastiCache staging/production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
